model CompanyMember {
  id              String       @id @default(uuid())
  companyId       String
  userId          String
  role            MemberRole
  status          MemberStatus @default(INVITED)
  inviteToken     String?      @unique @db.VarChar(255) // store a HASH of the token, not the raw token
  inviteExpiresAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  administeredDepartment  Department?   @relation("DepartmentAdmin")
  ledUnits                Unit[]        @relation("UnitLead")
  employee                Employee?
  approvedPayrollRuns     PayrollRun[]  @relation("PayrollApprover")
  createdTransactions     Transaction[] @relation("TransactionCreator")

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId, role])
  @@map("company_members")
}
