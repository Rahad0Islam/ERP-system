// ---------- Users ----------
enum AuthProvider {
  CREDENTIALS
  GOOGLE
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
  DELETED
}

// ---------- Companies ----------
enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// Role INSIDE one company. The platform owner is NOT here: that is users.isSuperAdmin.
enum MemberRole {
  OWNER
  DEPARTMENT_ADMIN
  EMPLOYEE
  SUPER_ADMIN // platform owner; set by a seed script, never by sign-up
}

enum MemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

// Used by departments, units and products
enum ActiveStatus {
  ACTIVE
  INACTIVE
}

// ---------- People ----------
enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

// ---------- Products, sales, production ----------
enum ProductType {
  FINISHED_GOOD
  RAW_MATERIAL
  SERVICE
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum ProductionStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  PRODUCTION_IN
  SALE_OUT
  WASTE
  ADJUSTMENT
}

// ---------- Money ----------
enum TransactionType {
  REVENUE
  EXPENSE
}

enum TransactionSource {
  MANUAL
  PAYROLL
  SALES_ORDER
}

enum TransactionStatus {
  POSTED
  VOID
}

// Fixed list (no categories table in the 15-table version).
// Adding a category later needs a migration.
enum TransactionCategory {
  SALES
  SERVICE_INCOME
  OTHER_INCOME
  SALARY
  RENT
  ELECTRICITY
  MARKETING
  TRANSPORT
  RAW_MATERIAL
  OTHER_EXPENSE
}
